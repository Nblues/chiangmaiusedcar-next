# ========================
# 🔥 Firebase Configuration (สำหรับ Backup)
# ========================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ========================
# 🔐 Admin Authentication (LOCAL ONLY)
# ========================
# ใช้สำหรับเข้าสู่ระบบหลังบ้าน: /admin/login
# - อย่าเว้นวรรคหรือขึ้นบรรทัดใหม่ท้ายค่า (ระบบจะ sanitize แต่ควรรักษาความสะอาดของข้อมูล)
# - กำหนดรหัสผ่านที่คาดเดายาก
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password

# คีย์ลับสำหรับเซ็น session cookie (HMAC)
# สร้างค่าใหม่แบบสุ่มอย่างน้อย 64 ตัวอักษร (hex) เช่น PowerShell:
#   [System.Guid]::NewGuid().ToString("N") + [System.Guid]::NewGuid().ToString("N")
SESSION_SECRET=replace_with_a_random_64_char_secret

# ========================
# 🛍️ Shopify Configuration
# ========================
# ใช้โดเมน myshopify.com เท่านั้น (เช่น your-store.myshopify.com)
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here
SHOPIFY_ADMIN_TOKEN=your_admin_access_token_here
SHOPIFY_API_VERSION=2025-01

# ========================
# 📧 EmailJS Configuration
# ========================
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# ========================
# 🔒 reCAPTCHA
# ========================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ========================
# 📊 Analytics & Tracking
# ========================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=939085106560508

# ========================
# 🌐 Site Configuration
# ========================
NEXT_PUBLIC_SITE_URL=https://www.chiangmaiusedcar.com
NEXT_PUBLIC_SITE_NAME=ครูหนึ่งรถสวย

# ========================
# 🔧 Development Only
# ========================
# ANALYZE=true
# NODE_ENV=development

# ========================
# ⏰ Cron Jobs
# ========================
CRON_SECRET=your_random_secret_for_cron_protection

# ========================
# 🔁 ISR / Revalidation
# ========================
REVALIDATE_SECRET=replace_with_random_secret

# ========================
# 🔔 Shopify Webhooks
# ========================
# ใช้สำหรับตรวจสอบ HMAC ของ Shopify webhook (x-shopify-hmac-sha256)
SHOPIFY_WEBHOOK_SECRET=replace_with_shopify_webhook_secret

# ========================
# 🤖 AI Valuation Dashboard (Supabase + Gemini)
# ========================
# ใช้สำหรับ /admin/valuation — ประเมินราคารถด้วย AI และบันทึกประวัติ
# RLS เปิดใช้งานบนตาราง valuations แล้ว เข้าถึงได้เฉพาะฝั่งเซิร์ฟเวอร์ผ่าน service role key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GEMINI_API_KEY=your_google_gemini_api_key
